{
  "extends": "./tsconfig.json",
  // ⚠️ `exclude` **不会**与基类合并（是覆盖），所以根 `tsconfig.json` 里写的每一条
  // 这里都要**再写一遍**。这个坑本仓库踩过两次：
  //   1. 早期 `packages/` 必须在两处都排除；
  //   2. 现在 `scripts/` 也一样 —— 只在根配置里加，`nest build` 照样会把它拉进 program，
  //      导致 tsc 推断的 `rootDir` 从 `src` 漂移成仓库根、产物变 `dist/src/main.js`。
  //
  // `**/__tests__/**` 是整个目录一起排除：只排 `**/*spec.ts` 的话，
  // 测试替身（`__tests__/fixtures/*.ts`，名字里没有 `spec`）会被 emit 进 `dist/`
  // —— 那是只该活在测试里的代码，不该发布。
  //
  // 当前测试已全部删除（见 README 的说明），但**保留这两条排除**：
  // 补回测试时不必再想一遍这件事，而且它是"源码目录 → 发布产物"的正确边界。
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "scripts",
    "**/*spec.ts",
    "**/__tests__/**"
  ]
}
