# 配置模板。复制成 `.env` 后按需修改：
#
#   cp .env.example .env
#
# 加载顺序（优先级从高到低，见 src/config/app-config.module.ts）：
#   .env.${NODE_ENV}.local → .env.local（test 环境跳过）→ .env.${NODE_ENV} → .env
#
# ⚠️ `.env` / `.env.local` / `.env.*` 都被 .gitignore 忽略（只有本文件入库）。
# ⚠️ 任何一个值不合法都会让**进程拒绝启动**（并在日志里一次性列出全部问题），
#    这是刻意的 fail-fast：配置错误不该等到某个请求进来才暴露。

# ── 应用 ──────────────────────────────────────────────────────────────────────

# development | test | production（默认 development）
NODE_ENV=development

# 监听端口，1..65535（默认 3000）
PORT=3000

# 监听地址。**留空表示绑定全部网卡**（与 Node 默认一致）；
# 只有在需要限定网卡时才设置，例如 HOST=127.0.0.1
# HOST=127.0.0.1

# ── 契约层开关 ────────────────────────────────────────────────────────────────
#
# 这两项由 app.module.ts 的 apiContractOptionsFactory 映射到 ApiContractModule：
#   STRICT_VALIDATION → forbidNonWhitelisted（多一个未声明字段就 400）
#   ENABLE_ENVELOPE   → 成功响应是否套 { success, data, meta? }
# 只认恰好 true / false。

# 默认 false：多余字段被 whitelist 静默剥掉。设 true 对契约更严格，
# 但前端/埋点/缓存破坏参数多带一个 query 就会 400。
# STRICT_VALIDATION=false

# 默认 true。设 false 后成功响应是 handler 的裸返回值；
# 失败响应不受影响（全局过滤器始终产出 { success:false, error, message, code?, traceId?, errors? }）。
# ENABLE_ENVELOPE=true

# ── 接口文档 /docs ────────────────────────────────────────────────────────────

# 只认恰好 true / false；不设时：production 关闭，其它环境开启。
# 注意 '1' / 'yes' 这类"含糊真值"不算数（会被当成没设）。
# ENABLE_SWAGGER=true

# 只影响文档里的 servers 展示（默认 http://localhost:3000）
# SWAGGER_SERVER_URL=http://localhost:3000

# ── 平台层（🅿️ 预留：配置先立契约，A2 才接线） ────────────────────────────────

# CORS 允许的来源，逗号分隔；默认 *（仅开发）。
# ⚠️ 生产环境留空或为 * 会打告警，A2 接上 CORS 后改为拒绝启动。
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# 限流：时间窗（秒）与窗口内允许的请求数（默认 60 / 100）
# THROTTLE_TTL_SECONDS=60
# THROTTLE_LIMIT=100

# ── 数据库（🅿️ 预留：本次不接任何 ORM，B1 才消费） ────────────────────────────
#
# driver 默认 memory = 不连数据库，所以**不设任何 DATABASE_* 也能启动**。
# 一旦 driver 改成 postgres / mysql / sqlite，就必须给出连接方式：
#   - 要么给 DATABASE_URL（**存在时优先**，下面的离散字段会被忽略）；
#   - 要么给齐 DATABASE_HOST / DATABASE_USER / DATABASE_NAME（sqlite 只需要 DATABASE_NAME）。
# 缺了必要字段会在启动期报错，而不是等到第一次查询。

# memory | postgres | mysql | sqlite（默认 memory）
# DATABASE_DRIVER=postgres

# 连接串写法（推荐）；密码请只在本地 .env 里出现
# DATABASE_URL=postgres://app:secret@localhost:5432/appdb

# 或者用离散字段（port 不填时：postgres 5432 / mysql 3306）
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=app
# DATABASE_PASSWORD=secret
# DATABASE_NAME=appdb
# DATABASE_SCHEMA=public

# 连接池大小 1..100（默认 10）
# DATABASE_POOL_SIZE=10

# 布尔项只认恰好 true / false
# DATABASE_SSL=false
# DATABASE_LOGGING=false

# ⚠️ 让 ORM 自动改表：**生产环境为 true 会直接拒绝启动**（会丢数据），
#    生产请改用迁移：DATABASE_MIGRATIONS_RUN=true
# DATABASE_SYNCHRONIZE=false
# DATABASE_MIGRATIONS_RUN=false
